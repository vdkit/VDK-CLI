{
  "name": "@vdkit/cli",
  "version": "3.0.2",
  "description": "Advanced Command-line toolkit that analyzes your codebase, migrates existing AI contexts from any platform, and deploys project-aware rules, memories, commands and agents to any AI coding assistant - VDK is the world's first Vibe Development Kit",
  "keywords": [
    "ai-assistant",
    "cli",
    "context-aware",
    "developer-tools",
    "migration",
    "multi-platform",
    "vdk",
    "vibe-coding"
  ],
  "license": "MIT",
  "author": "Dominikos Pritis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vdkit/VDK-CLI.git"
  },
  "bin": {
    "vdk": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/cli.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.build.json && node --input-type=module -e \"import { cpSync, mkdirSync } from 'node:fs'; mkdirSync('dist/src/templates/commands', { recursive: true }); cpSync('src/templates/commands/claude-code-command-template.md', 'dist/src/templates/commands/claude-code-command-template.md');\"",
    "check": "oxlint src/ && oxfmt --check src/",
    "check-duplicates": "node --import tsx src/validation/check-duplicates.ts",
    "check:fix": "oxlint --fix src/ && oxfmt --write src/",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "health-check": "node --import tsx src/utils/health-check.ts",
    "insights": "node --import tsx src/utils/project-insights.ts",
    "lint": "oxlint .",
    "lint:contracts": "oxlint --import-plugin -c .oxlintrc.json \"lint/blueprint-lint-trigger.ts\"",
    "lint:contracts:dry": "vdk-blueprints-fix --target .vdk/blueprints/rules --ext md",
    "lint:contracts:fix": "vdk-blueprints-fix --write --target .vdk/blueprints/rules --ext md",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "lint:fix-unsafe": "oxlint --fix --fix-suggestions --fix-dangerously . && oxfmt --write .",
    "lint:json": "oxfmt --check --no-error-on-unmatched-pattern vdk.config.json package.json",
    "lint:md": "markdownlint-cli2 '**/*.md'",
    "lint:md:fix": "markdownlint-cli2 -fix '**/*.md'",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run validate && pnpm run lint && pnpm run format:check",
    "quality": "pnpm run typecheck && pnpm run lint && pnpm run lint:contracts && pnpm run format:check && pnpm run lint:md",
    "quality:fix": "pnpm run lint:contracts:fix && pnpm run lint:fix && pnpm run format && pnpm run lint:md:fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "node --import tsx src/validation/validate-rules.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@octokit/rest": "^22.0.1",
    "@vdkit/ai-context-schema": "latest",
    "acorn": "^8.17.0",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "15.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "figures": "^6.1.0",
    "fs-extra": "^11.3.6",
    "glob": "^13.0.6",
    "glob-to-regexp": "^0.4.1",
    "gradient-string": "^3.0.0",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.9",
    "js-yaml": "^5.2.1",
    "jscodeshift": "^17.3.0",
    "marked": "^18.0.5",
    "marked-terminal": "^7.3.0",
    "open": "^11.0.0",
    "ora": "^9.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vdkit/oxlint-plugin-blueprints": "^1.0.0",
    "@vitest/browser": "beta",
    "@vitest/coverage-v8": "beta",
    "@vitest/ui": "beta",
    "markdownlint-cli2": "^0.23.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "strip-ansi": "^7.2.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "beta"
  },
  "engines": {
    "node": ">=24.19.0",
    "pnpm": ">=11.20.0"
  },
  "packageManager": "pnpm@11.20.0"
}
